# PostgreSQL connection. Use a local database or the connection details from Supabase.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=laundry_db
DB_SSL=false
# Keep certificate validation enabled outside local development.
DB_SSL_REJECT_UNAUTHORIZED=true

# Backend
PORT=3001
NODE_ENV=development

# Authentication: replace with a long, random value in the local .env file.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Frontend origin allowed to call the backend
CORS_ORIGINS=http://localhost:3000

# Swagger
SWAGGER_TITLE=PUNTO LAVANDERIA API
SWAGGER_DESCRIPTION=API para la gestión de PUNTO LAVANDERIA
SWAGGER_VERSION=1.0

# Logging
LOG_LEVEL=debug
